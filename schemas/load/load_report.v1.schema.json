{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lemma.dev/schemas/load/load_report.v1.schema.json",
  "title": "Lemma Load Readiness Report v1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "status",
    "target",
    "approved",
    "limits",
    "summary",
    "evidence"
  ],
  "properties": {
    "schema_version": { "const": "lemma.load_report/v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["completed", "halted", "rejected"] },
    "target": { "type": "string", "minLength": 1 },
    "approved": { "type": "boolean" },
    "safe_target_validated": { "type": "boolean" },
    "limits": {
      "type": "object",
      "required": ["max_concurrent_connections", "max_total_requests", "max_wall_clock_ms"],
      "properties": {
        "max_concurrent_connections": { "type": "integer", "minimum": 1 },
        "max_total_requests": { "type": "integer", "minimum": 1 },
        "max_wall_clock_ms": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": ["requests_attempted", "requests_completed", "requests_failed", "halted_reason"],
      "properties": {
        "requests_attempted": { "type": "integer", "minimum": 0 },
        "requests_completed": { "type": "integer", "minimum": 0 },
        "requests_failed": { "type": "integer", "minimum": 0 },
        "halted_reason": { "type": ["string", "null"] },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "concurrency_peak": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "timing_histogram": {
      "type": "object",
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["directory", "manifest", "artifacts"],
      "properties": {
        "directory": { "type": "string" },
        "manifest": { "type": "string" },
        "artifacts": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "errors": {
      "type": "array",
      "items": { "type": "object" }
    }
  },
  "additionalProperties": true
}
