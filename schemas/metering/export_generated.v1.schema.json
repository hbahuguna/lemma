{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lemma.dev/schemas/metering/export_generated.v1.schema.json",
  "title": "Lemma metering event export_generated v1",
  "$ref": "#/definitions/ExportGeneratedEvent",
  "definitions": {
    "ExportGeneratedEvent": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": [
            "lemma.metering/v1",
            "quality-harness.metering/v1"
          ]
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "event_type": {
          "type": "string",
          "const": "export_generated"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "workspace": {
          "type": "string",
          "minLength": 1
        },
        "run": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "event_type",
        "idempotency_key",
        "workspace",
        "run",
        "quantity",
        "unit",
        "timestamp",
        "source"
      ],
      "additionalProperties": true
    }
  }
}
