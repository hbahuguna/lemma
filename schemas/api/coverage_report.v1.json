{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lemma.dev/schemas/api/coverage_report.v1.json",
  "title": "Lemma API Coverage Report v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "run_id",
    "status",
    "target",
    "safe_target_validated",
    "max_cases",
    "cases",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "lemma.api_coverage_report/v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["completed", "halted", "rejected"] },
    "target": { "type": "string", "minLength": 1 },
    "safe_target_validated": { "type": "boolean" },
    "max_cases": { "type": "integer", "minimum": 1 },
    "spec_source": { "type": ["string", "null"] },
    "traffic_source": { "type": ["string", "null"] },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "class", "source", "operation", "request", "ui_flow"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "class": { "type": "string", "enum": ["positive", "negative", "boundary", "auth", "tenant", "idempotency"] },
          "source": {
            "type": "object",
            "additionalProperties": true,
            "required": ["type", "ref"],
            "properties": {
              "type": { "type": "string", "enum": ["spec_operation", "observed_traffic"] },
              "ref": { "type": "string", "minLength": 1 }
            }
          },
          "operation": { "type": "string", "minLength": 1 },
          "request": { "type": "object", "additionalProperties": true },
          "ui_flow": {
            "oneOf": [
              { "type": "string", "const": "unknown" },
              {
                "type": "object",
                "additionalProperties": true,
                "required": ["operation", "screen", "user_journey"],
                "properties": {
                  "operation": { "type": "string" },
                  "screen": { "type": "string" },
                  "user_journey": { "type": "string" }
                }
              }
            ]
          },
          "result": { "type": ["object", "null"] },
          "failure": { "type": ["object", "null"] }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["total_cases", "by_class", "failures", "mapped_failures", "unmapped_failures"],
      "properties": {
        "total_cases": { "type": "integer", "minimum": 0 },
        "by_class": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "failures": { "type": "integer", "minimum": 0 },
        "mapped_failures": { "type": "integer", "minimum": 0 },
        "unmapped_failures": { "type": "integer", "minimum": 0 },
        "capped": { "type": "boolean" }
      }
    }
  }
}
