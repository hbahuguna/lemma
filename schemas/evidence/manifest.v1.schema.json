{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lemma.dev/schemas/evidence/manifest.v1.schema.json",
  "title": "Lemma evidence manifest v1",
  "$ref": "#/definitions/EvidenceManifest",
  "definitions": {
    "EvidenceManifest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "anyOf": [
            {
              "type": "string",
              "const": "lemma.evidence-manifest/v1"
            },
            {
              "type": "string",
              "const": "1.0"
            },
            {
              "type": "string"
            }
          ]
        },
        "run_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "finalized_at": {
          "anyOf": [
            {
              "$ref": "#/definitions/EvidenceManifest/properties/created_at"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "check_id": {
                "type": "string"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "minLength": 1
              },
              "content_type": {
                "type": "string"
              },
              "created_at": {
                "$ref": "#/definitions/EvidenceManifest/properties/created_at"
              }
            },
            "required": [
              "path",
              "kind",
              "bytes",
              "sha256"
            ],
            "additionalProperties": true
          }
        },
        "signature": {
          "type": "string"
        },
        "signature_algorithm": {
          "type": "string"
        },
        "signed_at": {
          "$ref": "#/definitions/EvidenceManifest/properties/created_at"
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "evidence"
      ],
      "additionalProperties": true
    }
  }
}
