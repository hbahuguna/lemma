{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lemma.dev/schemas/mcp/lemma_start.input.schema.json",
  "title": "lemma_start input",
  "type": "object",
  "additionalProperties": false,
  "required": ["target"],
  "properties": {
    "target": { "type": "string", "minLength": 1 },
    "root": { "type": "string" },
    "intent": { "type": "string" },
    "workflow_id": { "type": "string" },
    "max_checks": { "type": "integer", "minimum": 1 },
    "resume": { "type": "boolean" },
    "personas": { "type": "array", "items": { "type": "string" } },
    "personas_dir": { "type": "string" },
    "seed": { "type": "integer" },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["real", "frozen"] },
        "frozen": { "type": ["string", "null"] }
      }
    }
  }
}
