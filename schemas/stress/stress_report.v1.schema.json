{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lemma.dev/schemas/stress/stress_report.v1.schema.json",
  "title": "Lemma Stress Risk Report v1",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "phases", "findings", "evidence"],
  "properties": {
    "schema_version": { "const": "lemma.stress_report/v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["completed", "halted"] },
    "target": { "type": ["string", "null"] },
    "phases": {
      "type": "object",
      "required": ["static", "bounded_loop", "recovery"],
      "properties": {
        "static": { "type": "object" },
        "bounded_loop": { "type": "object" },
        "recovery": { "type": "object" }
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "title", "evidence", "kind"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string" },
          "title": { "type": "string" },
          "kind": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "experiments": { "type": "array", "items": { "type": "object" } },
    "evidence": {
      "type": "object",
      "required": ["directory", "manifest", "artifacts"],
      "properties": {
        "directory": { "type": "string" },
        "manifest": { "type": "string" },
        "artifacts": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
