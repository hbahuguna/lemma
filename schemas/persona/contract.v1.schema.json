{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lemma.dev/schemas/persona/contract.v1.schema.json",
  "title": "Lemma persona contract v1",
  "$ref": "#/definitions/PersonaContract",
  "definitions": {
    "PersonaContract": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "lemma.persona-contract/v1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "owns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "refusal": {
          "type": "string"
        },
        "required_sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": true
    }
  }
}
