{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lemma.dev/schemas/state/progress.v1.schema.json",
  "title": "Lemma progress/state v1",
  "$ref": "#/definitions/Progress",
  "definitions": {
    "Progress": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "lemma.progress/v1"
        },
        "state": {
          "type": "object",
          "properties": {
            "schema_version": {
              "type": "string"
            },
            "run_id": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "target": {
              "type": "object",
              "additionalProperties": {}
            },
            "phases": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "checks": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string"
                        },
                        "evidence": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "id",
                        "status"
                      ],
                      "additionalProperties": true
                    }
                  }
                },
                "required": [
                  "id",
                  "status"
                ],
                "additionalProperties": true
              }
            },
            "started_at": {
              "type": "string",
              "minLength": 1
            },
            "completed_at": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Progress/properties/state/properties/started_at"
                },
                {
                  "type": "null"
                }
              ]
            },
            "updated_at": {
              "$ref": "#/definitions/Progress/properties/state/properties/started_at"
            },
            "workflow_id": {
              "type": "string"
            },
            "workflow_version": {
              "type": "string"
            },
            "evidence_dir": {
              "type": "string"
            },
            "findings": {
              "type": "array",
              "items": {}
            },
            "confidence": {}
          },
          "required": [
            "run_id",
            "status"
          ],
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
