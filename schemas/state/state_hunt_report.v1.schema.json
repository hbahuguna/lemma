{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lemma.dev/schemas/state/state_hunt_report.v1.schema.json",
  "title": "Lemma State Hunt Report v1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "status",
    "target",
    "coverage",
    "sequences_exercised",
    "findings",
    "evidence"
  ],
  "properties": {
    "schema_version": { "const": "lemma.state_hunt_report/v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["completed", "halted"] },
    "target": { "type": "string" },
    "coverage": {
      "type": "object",
      "required": ["status", "sequences_exercised", "steps_executed"],
      "properties": {
        "status": { "type": "string", "enum": ["UNCHANGED", "CHANGED"] },
        "sequences_exercised": { "type": "integer", "minimum": 0 },
        "steps_executed": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "sequences_exercised": { "type": "array", "items": { "type": "object" } },
    "findings": { "type": "array", "items": { "type": "object" } },
    "halted_reason": { "type": ["string", "null"] },
    "deterministic": { "type": "object", "additionalProperties": true },
    "evidence": {
      "type": "object",
      "required": ["directory", "manifest", "artifacts"],
      "properties": {
        "directory": { "type": "string" },
        "manifest": { "type": "string" },
        "artifacts": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
