{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lemma.dev/schemas/confidence/specialized_review.v1.schema.json",
  "title": "Lemma Specialized Review Report v1",
  "type": "object",
  "required": [
    "schema_version",
    "review_id",
    "kind",
    "run_id",
    "workspace",
    "status",
    "checklist",
    "unreviewed_items",
    "findings",
    "evidence_links",
    "recorded_at"
  ],
  "properties": {
    "schema_version": { "const": "lemma.confidence.specialized_review/v1" },
    "review_id": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "enum": ["security", "skeptical", "statistical", "release"] },
    "run_id": { "type": "string" },
    "workspace": { "type": "string" },
    "status": { "type": "string" },
    "checklist": { "type": "object" },
    "unreviewed_items": { "type": "array", "items": { "type": "string" } },
    "findings": { "type": "array", "items": { "type": "object" } },
    "evidence_links": { "type": "object", "additionalProperties": true },
    "release_decision": { "type": ["string", "null"] },
    "recorded_at": { "type": "string" }
  },
  "additionalProperties": true
}
