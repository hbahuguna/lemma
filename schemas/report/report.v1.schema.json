{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lemma.dev/schemas/report/report.v1.schema.json",
  "title": "Lemma report v1",
  "description": "Machine-readable report emitted by lemma run.",
  "$ref": "#/definitions/ReportV1",
  "definitions": {
    "ReportV1": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": [
            "lemma.report/v1",
            "quality-harness.report/v1"
          ]
        },
        "generated_at": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "determinism": {
          "type": "object",
          "properties": {
            "seed": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "clock_mode": {
              "type": "string"
            },
            "entropy": {
              "type": "string"
            }
          },
          "required": [
            "seed",
            "clock_mode",
            "entropy"
          ],
          "additionalProperties": true
        },
        "status": {
          "type": "string"
        },
        "workflow": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "phases": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "id",
            "name",
            "version",
            "phases"
          ],
          "additionalProperties": true
        },
        "target": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string"
            },
            "raw": {
              "type": "string"
            },
            "resolved": {
              "type": "string"
            },
            "source": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "raw",
            "resolved",
            "source"
          ],
          "additionalProperties": true
        },
        "intent": {
          "type": "string"
        },
        "policy": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": true
        },
        "metering": {
          "type": "object",
          "properties": {
            "schema_version": {
              "type": "string"
            },
            "sink": {
              "type": "string"
            },
            "workspace": {
              "type": "string"
            },
            "event_count": {
              "type": "integer"
            },
            "event_types": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            }
          },
          "required": [
            "schema_version",
            "sink",
            "workspace",
            "event_count",
            "event_types"
          ],
          "additionalProperties": true
        },
        "decision": {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string"
            },
            "rationale": {
              "type": "string"
            }
          },
          "required": [
            "decision",
            "rationale"
          ],
          "additionalProperties": true
        },
        "trend": {
          "type": "object",
          "properties": {
            "baseline": {
              "type": "boolean"
            },
            "previous_run_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "new": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "resolved": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "persistent": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "score_delta": {
              "type": "number"
            },
            "coverage_delta": {
              "type": "number"
            }
          },
          "required": [
            "baseline",
            "previous_run_id",
            "new",
            "resolved",
            "persistent",
            "score_delta",
            "coverage_delta"
          ],
          "additionalProperties": true
        },
        "confidence": {
          "type": "object",
          "properties": {
            "score": {
              "type": "number"
            },
            "band": {
              "type": "string"
            },
            "coverage": {
              "type": "object",
              "additionalProperties": {}
            },
            "rationale": {
              "type": "string"
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "penalties": {
              "type": "array",
              "items": {}
            },
            "domain_scores": {
              "type": "object",
              "additionalProperties": {}
            },
            "breakdown": {
              "type": "array",
              "items": {}
            },
            "gate": {
              "type": "object",
              "additionalProperties": {}
            }
          },
          "required": [
            "score",
            "band",
            "coverage",
            "rationale",
            "limitations",
            "penalties",
            "domain_scores",
            "breakdown",
            "gate"
          ],
          "additionalProperties": true
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "check_id": {
                "type": "string"
              },
              "severity": {
                "type": "string"
              },
              "status": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "finding_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "invalid_findings": {
          "type": "array",
          "items": {}
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {},
            "additionalProperties": true
          }
        },
        "contract_failures": {
          "type": "array",
          "items": {}
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {},
            "additionalProperties": true
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": {}
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {},
            "additionalProperties": true
          }
        },
        "personas": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {},
            "additionalProperties": true
          }
        },
        "inventory": {
          "type": "object",
          "additionalProperties": {}
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {},
            "additionalProperties": true
          }
        },
        "kill_switch": {
          "type": "object",
          "properties": {
            "armed": {
              "type": "boolean"
            },
            "triggered": {
              "type": "boolean"
            },
            "threshold": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "finding_id": {
              "type": "string"
            },
            "manual": {
              "type": "boolean"
            },
            "triggered_at": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "armed",
            "triggered",
            "threshold",
            "reason",
            "finding_id",
            "manual",
            "triggered_at"
          ],
          "additionalProperties": true
        },
        "halted_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "object",
          "properties": {
            "directory": {
              "type": "string"
            },
            "summary": {
              "$ref": "#/definitions/ReportV1/properties/inventory"
            }
          },
          "required": [
            "directory",
            "summary"
          ],
          "additionalProperties": true
        },
        "started_at": {
          "$ref": "#/definitions/ReportV1/properties/generated_at"
        },
        "completed_at": {
          "$ref": "#/definitions/ReportV1/properties/generated_at"
        },
        "options": {
          "$ref": "#/definitions/ReportV1/properties/inventory"
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "generated_at",
        "run_id",
        "determinism",
        "status",
        "workflow",
        "target",
        "intent",
        "policy",
        "metering",
        "decision",
        "trend",
        "confidence",
        "findings",
        "finding_counts",
        "invalid_findings",
        "blockers",
        "contract_failures",
        "checks",
        "coverage",
        "risks",
        "personas",
        "inventory",
        "phases",
        "kill_switch",
        "halted_reason",
        "limitations",
        "evidence",
        "started_at",
        "completed_at",
        "options",
        "error"
      ],
      "additionalProperties": true
    }
  }
}
