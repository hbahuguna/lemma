{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lemma.dev/schemas/release_brief/release_brief.v1.schema.json",
  "title": "Lemma Release Brief v1",
  "description": "Deterministic stakeholder-facing release brief derived from a lemma report.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "decision",
    "confidence",
    "coverage",
    "top_findings",
    "blockers",
    "coverage_gaps",
    "next_steps",
    "markdown",
    "html"
  ],
  "properties": {
    "schema_version": { "const": "lemma.release_brief/v1" },
    "run_id": { "type": ["string", "null"] },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "rationale", "context"],
      "properties": {
        "decision": { "type": "string", "enum": ["ship", "review", "hold", "unknown"] },
        "rationale": { "type": "string" },
        "context": { "type": "string" }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": true
    },
    "coverage": {
      "type": "object",
      "additionalProperties": true
    },
    "top_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "severity", "check_id"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "severity": { "type": "string" },
          "check_id": { "type": "string" }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "coverage_gaps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "next_steps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "markdown": { "type": "string" },
    "html": { "type": "string" }
  }
}
