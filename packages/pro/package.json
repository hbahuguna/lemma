{
  "name": "@lemma/pro",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Commercial, entitlement-gated Pro capabilities for lemma.",
  "license": "UNLICENSED",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./entitlement": {
      "types": "./dist/entitlement.d.ts",
      "import": "./dist/entitlement.js"
    },
    "./package.json": "./package.json",
    "./commands/specialists": {
      "types": "./dist/commands/specialists.d.ts",
      "import": "./dist/commands/specialists.js"
    },
    "./proof": {
      "types": "./dist/proof.d.ts",
      "import": "./dist/proof.js"
    },
    "./proof/backends": {
      "types": "./dist/proof/backends/index.d.ts",
      "import": "./dist/proof/backends/index.js"
    },
    "./inventory": {
      "types": "./dist/inventory.d.ts",
      "import": "./dist/inventory.js"
    },
    "./quality-history": {
      "types": "./dist/quality-history.d.ts",
      "import": "./dist/quality-history.js"
    },
    "./integrations/jira-xray": {
      "types": "./dist/integrations/jira-xray.d.ts",
      "import": "./dist/integrations/jira-xray.js"
    },
    "./integrations/testrail": {
      "types": "./dist/integrations/testrail.d.ts",
      "import": "./dist/integrations/testrail.js"
    },
    "./model-eval": {
      "types": "./dist/model-eval.d.ts",
      "import": "./dist/model-eval.js"
    },
    "./revisions": {
      "types": "./dist/revisions.d.ts",
      "import": "./dist/revisions.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/entitlement.ts src/commands/specialists.ts src/proof.ts src/proof/backends/index.ts src/inventory.ts src/quality-history.ts src/integrations/jira-xray.ts src/integrations/testrail.ts src/model-eval.ts src/revisions.ts --format esm --dts --clean --sourcemap --target node20 src/cloud-execution.ts src/steered-plan.ts src/dashboard/plan.ts src/personas.ts src/bots.ts src/evidence-bundle.ts src/health-score.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@lemma/core": "workspace:*"
  },
  "peerDependencies": {
    "@lemma/cloud": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@lemma/cloud": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hbahuguna/lemma.git",
    "directory": "packages/pro"
  },
  "devDependencies": {
    "vitest": "^3.2.0"
  }
}
