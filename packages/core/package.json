{
  "name": "@lemma/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Host-neutral deterministic release-confidence engine.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap --target node20",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "schemas:generate": "tsx ../../scripts/schemas/generate.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "vitest": "^3.2.0",
    "zod-to-json-schema": "^3.25.2"
  }
}
