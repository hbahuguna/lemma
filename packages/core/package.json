{
  "name": "@lemma/core",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Host-neutral deterministic release-confidence engine.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./cloud": {
      "types": "./dist/cloud.d.ts",
      "import": "./dist/cloud.js"
    },
    "./personas": {
      "types": "./dist/personas.d.ts",
      "import": "./dist/personas.js"
    },
    "./outcomes": {
      "types": "./dist/outcomes.d.ts",
      "import": "./dist/outcomes.js"
    },
    "./ssrf": {
      "types": "./dist/ssrf-export.d.ts",
      "import": "./dist/ssrf-export.js"
    },
    "./exports": {
      "types": "./dist/exports.d.ts",
      "import": "./dist/exports.js"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "import": "./dist/plugins.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard.d.ts",
      "import": "./dist/dashboard.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/plugins.ts src/browser.ts src/cloud.ts src/personas.ts src/outcomes.ts src/ssrf-export.ts src/exports.ts src/dashboard.ts src/mcp.ts src/more.ts src/auto-loop.ts src/browser-command.ts src/human-context.ts src/feedback.ts src/generate.ts src/test-intent.ts --format esm --dts --clean --sourcemap --target node20 src/upgrade.ts src/load.ts src/stress.ts src/state-hunt.ts src/agent-readiness.ts src/geo.ts src/intl.ts src/review.ts src/release-decision.ts src/incident.ts src/forever.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "schemas:generate": "tsx ../../scripts/schemas/generate.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "vitest": "^3.2.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hbahuguna/lemma.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@lemma/browser": "workspace:*",
    "@lemma/cloud": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@lemma/browser": {
      "optional": true
    },
    "@lemma/cloud": {
      "optional": true
    }
  }
}
