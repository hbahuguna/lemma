{
  "name": "lemma-sample-check-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Example signed check plugin for lemma",
  "type": "module",
  "main": "./sample-check.ts",
  "exports": {
    ".": "./sample-check.ts"
  },
  "scripts": {
    "check": "node --check ./sample-check.ts || true"
  },
  "keywords": [
    "lemma",
    "plugin",
    "quality-harness"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lemma/core": ">=0.0.0"
  },
  "lemma": {
    "checks": {
      "sample_check": "./sample-check.ts#PLUGIN"
    }
  }
}
