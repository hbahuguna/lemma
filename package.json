{
  "name": "lemma",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Deterministic release confidence as a plugin for OpenCode, Claude Code, Codex, Antigravity, and Cursor.",
  "license": "MIT",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "clean": "pnpm -r --if-present clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "parity:check": "node scripts/parity/check.mjs",
    "parity:write": "node scripts/parity/check.mjs --write",
    "test": "vitest run",
    "test:parity": "node scripts/parity/harness.mjs --test",
    "parity:baselines": "node scripts/parity/harness.mjs --write-baselines",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "test:e2e": "vitest run packages/adapters/opencode/test/opencode-e2e-parity.test.ts packages/adapters/claude-code/test/claude-code-e2e.test.ts packages/adapters/codex/test/codex-smoke.test.ts packages/adapters/antigravity/test/antigravity-smoke.test.ts packages/adapters/cursor/test/cursor-smoke.test.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@eslint/js": "^9.30.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.6.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.36.0",
    "vitest": "^3.2.0"
  }
}
